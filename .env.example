# Copy to .env and fill in. Never commit .env.
# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8010
# debug | info | warning | error
LOG_LEVEL=info

# ---- LLM Gateway (01-llm-gateway) - ALL model inference goes through here ----
# OpenAI-compatible base URL of the gateway
GATEWAY_BASE_URL=http://localhost:8000/v1
# Must be one of the gateway's GATEWAY_API_KEYS
GATEWAY_API_KEY=
# Model names as exposed by the gateway
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
# Optional local cross-encoder reranker (blank = LLM reranking via the gateway)
RERANKER_MODEL=

# ---- OpenSearch (BM25) ----
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=pmc_chunks
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ---- Qdrant (dense vectors) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pmc_chunks
QDRANT_API_KEY=

# ---- Retrieval ----
RETRIEVAL_TOP_K=50
RERANK_TOP_K=8
# Minimum evidence score before the system abstains (0-1)
ABSTAIN_THRESHOLD=0.35

# ---- Data / NCBI (optional, recommended for bulk downloads) ----
DATA_DIR=./data
NCBI_EMAIL=
NCBI_API_KEY=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=healthcare-rag
