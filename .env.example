# Copy to .env and fill in. Never commit .env.
# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8010
# debug | info | warning | error
LOG_LEVEL=info

# ---- LLM Gateway (01-llm-gateway) - ALL model inference goes through here ----
# OpenAI-compatible base URL of the gateway. Use 127.0.0.1, not localhost: on Windows a new
# connection to "localhost" tries IPv6 first and waits ~2 s before falling back to IPv4.
GATEWAY_BASE_URL=http://127.0.0.1:8000/v1
# Gateway URL as seen from inside docker compose (the gateway runs on the host)
GATEWAY_BASE_URL_DOCKER=http://host.docker.internal:8000/v1
# Must be one of the gateway's GATEWAY_API_KEYS
GATEWAY_API_KEY=
# Model names as exposed by the gateway
CHAT_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
GATEWAY_TIMEOUT_SECONDS=120
# true = send Cache-Control: no-cache so every answer is generated (evaluation sets this)
GATEWAY_BYPASS_CACHE=false
# Hugging Face cross-encoder for reranking (needs the [rerank] extra); blank = no reranking
RERANKER_MODEL=ncbi/MedCPT-Cross-Encoder
# cpu | cuda
RERANKER_DEVICE=cuda
# nomic-embed-text task prefixes; set both blank for other embedding models
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOC_PREFIX="search_document: "
# Optional. Not used by the service (inference goes through the gateway); reserved for
# evaluation tooling such as an external LLM judge.
OPENAI_API_KEY=

# ---- OpenSearch (BM25) ----
# docker compose overrides OPENSEARCH_URL and QDRANT_URL with the in-network service names
# Use 127.0.0.1, not localhost: on Windows, Docker Desktop's IPv6 (::1) forwarding added
# ~43 ms to every OpenSearch request in testing.
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=pmc_chunks
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ---- Qdrant (dense vectors) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pmc_chunks
QDRANT_API_KEY=
# Timeout (seconds) for the /ready probes against OpenSearch, Qdrant and the gateway
PROBE_TIMEOUT_SECONDS=2.0

# ---- Retrieval ----
# bm25 | dense | hybrid (reciprocal rank fusion of BM25 and dense)
RETRIEVAL_MODE=hybrid
RRF_K=60
# Candidates retrieved before reranking
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
# Abstain when the best reranker score is below this (MedCPT logit units; tuned on the
# dev split by `make eval`, see docs/evaluation_report.md)
ABSTAIN_THRESHOLD=6.43
# Abstain when the answer cites none of the passages it was given
REQUIRE_CITATIONS=true
# Follow-up turns asking the model to add citations to an uncited answer (0 = off)
CITATION_REPAIRS=1
# System prompt version: v1 | v2 (see healthcare_rag/rag.py)
PROMPT_VERSION=v1
# How an uncited answer gets citations: llm (follow-up turn) | attribute (match each
# sentence to its supporting passage, no LLM call) | attribute_then_llm
CITATION_REPAIR=llm
# Sentence-level citation check: off | relabel (fix wrong citations) | drop (also remove
# unsupported sentences)
CITATION_CHECK=off
SUPPORT_THRESHOLD=0.6
# Blank = lexical support scoring; e.g. cross-encoder/nli-deberta-v3-base for NLI scoring
NLI_MODEL=
# Optional second reranker fused with the first (e.g. BAAI/bge-reranker-v2-m3), and the
# weight of the retriever's own order in that fusion (0 = off)
RERANKER_MODEL_2=
RERANKER_RETRIEVAL_WEIGHT=0

# ---- Data / NCBI (optional, recommended for bulk downloads) ----
DATA_DIR=./data
NCBI_EMAIL=
NCBI_API_KEY=

# ---- Observability ----
# Blank = tracing off. To trace /ask end to end with the gateway, use 01's Jaeger:
# http://127.0.0.1:4318 (UI on http://127.0.0.1:16686)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=healthcare-rag
